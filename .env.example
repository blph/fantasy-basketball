# Copy to .env and fill in. .env is gitignored — never commit real keys.

# FantasyPros API — sent as the `x-api-key` request header.
# Request access: https://www.fantasypros.com/api-data/
FANTASYPROS_API_KEY=

# Yahoo Fantasy Sports API (OAuth2) — league state: our roster, opponents,
# matchups, free agents. Not yet integrated; see docs/api/fantasypros-endpoints.md
# "Open questions". Register an app at https://developer.yahoo.com/apps/
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REFRESH_TOKEN=
