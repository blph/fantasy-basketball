# Copy to .env and fill in. .env is gitignored — never commit real keys.

# FantasyPros API — sent as the `x-api-key` request header.
# Request access: https://www.fantasypros.com/api-data/
FANTASYPROS_API_KEY=

# Yahoo Fantasy Sports API (OAuth2) — league state: our roster, opponents,
# matchups, free agents. Not yet integrated; see docs/api/fantasypros-endpoints.md
# "Open questions". Register an app at https://developer.yahoo.com/apps/
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REFRESH_TOKEN=

# The draft board Google Sheet, by the id in its URL
# (docs.google.com/spreadsheets/d/<SHEET_ID>/edit). Read by
# scripts/draft-board/pull_sheet.py. Not a credential, but it names a private
# file in a public repo, so scripts/check-no-data.sh blocks it everywhere else.
DRAFT_SHEET_ID=
